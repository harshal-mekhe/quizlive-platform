# Copy this file to .env.local and fill in your Supabase credentials.
# Get values from: Supabase Dashboard → Project Settings → API
#
# After creating .env.local:
#   npm run dev          → works immediately
#   npm run build        → required before npm run preview (env is baked in at build time)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
